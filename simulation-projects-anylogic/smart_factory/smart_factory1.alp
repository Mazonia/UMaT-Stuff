							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[rejectedCount++;

double rejectRate = 0.0;

if (rawPartArrival.count() > 0) {
    rejectRate =
        ((double) rejectedCount / (double) rawPartArrival.count()) * 100.0;
}

traceln(
    "Total Rejects: " + rejectedCount +
    " | Current Reject Rate: " + format(rejectRate) + "%"
);]]></Code>
							</Value>
